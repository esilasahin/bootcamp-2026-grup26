APP_NAME=UniMate AI API
APP_VERSION=0.1.0
ENVIRONMENT=development
API_V1_PREFIX=/api/v1

DATABASE_URL=postgresql+psycopg://unimate:unimate_password@localhost:5432/unimate

JWT_SECRET_KEY=replace-with-a-long-random-secret-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

MAX_UPLOAD_SIZE_MB=10
ALLOWED_CV_EXTENSIONS=pdf,docx,txt

# OCR
TESSERACT_CMD=
POPPLER_PATH=
OCR_LANGUAGE=tur
OCR_DPI=300

# LLM
LLM_PROVIDER=local
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
LLM_TIMEOUT_SECONDS=30
LLM_MAX_INPUT_CHARS=50000